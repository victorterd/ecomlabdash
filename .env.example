# --- Supabase → Project Settings → API Keys ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Doar pe server (cron, notificări). Nu o expune niciodată în browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Adresa aplicației (pentru linkurile din email) ---
NEXT_PUBLIC_SITE_URL=https://ecomlab-crm.vercel.app

# --- Cron: un șir lung, aleator (ex. generat cu un manager de parole) ---
CRON_SECRET=

# --- Email zilnic prin Resend (resend.com → API Keys) ---
RESEND_API_KEY=re_...
# Expeditorul. Cu domeniu verificat în Resend: „Ecomlab CRM <crm@ecomlab.ro>”.
# Fără domeniu verificat, Resend permite doar onboarding@resend.dev și doar către emailul contului tău Resend.
EMAIL_FROM=Ecomlab CRM <onboarding@resend.dev>

# --- Notificări push (generează cheile din Setări → Notificări) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emailul-tau@domeniu.ro
